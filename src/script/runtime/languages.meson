toolchain = import('toolchain')

toolchain.register_language(
 	'object',
    is_linkable: true,
    file_extensions: ['o', 'obj'],
)

toolchain.register_language(
    'c',
    family: 'c',
    file_extensions: ['c'],
    toolchain_options: {
        'compiler': 'CC',
        'linker': 'CC_LD',
        'archiver': 'AR',
    },
    options: {
        'std': toolchain.option(type: 'string', value: 'none'),
        'std': toolchain.option(type: 'string', value: 'none'),
        'args': toolchain.option(type: 'shell_array', inherit_env: ['CFLAGS', 'CPPFLAGS']),
        'link_args': toolchain.option(type: 'shell_array', inherit_env: ['LDFLAGS', 'CPPFLAGS']),
        'winlibs': toolchain.option(type: 'array', value: []), # TODO
        'thread_count': toolchain.option(type: 'array', value: []), # TODO
    },
    link_language: func(cur str) -> str
        if cur in ['cpp']
            return cur
        endif
        return 'c'
    endfunc
)

toolchain.register_language(
 	'c_header',
    family: 'c',
    is_header: true,
    file_extensions: ['h'],
)

toolchain.register_language(
    'cpp',
    toolchain_options: {
        'compiler': 'CXX',
        'linker': 'CXX_LD',
        'archiver': 'AR',
    },
    family: 'c',
    file_extensions: ['cc', 'cpp', 'cxx', 'C'],
)

toolchain.register_language(
 	'cpp_header',
    family: 'c',
    is_header: true,
    file_extensions: ['hh', 'hpp', 'hxx'],
)

toolchain.register_language(
    'objc',
    toolchain_options: {
        'compiler': 'OBJC',
        'linker': 'OBJC_LD',
        'archiver': 'AR',
    },
    family: 'c',
    file_extensions: [ 'm', 'M' ],
)

toolchain.register_language(
 	'objc_header',
    family: 'c',
    is_header: true,
)

toolchain.register_language(
    'objcpp',
    toolchain_options: {
        'compiler': 'OBJCXX',
        'linker': 'OBJCXX_LD',
        'archiver': 'AR',
    },
    family: 'c',
    file_extensions: ['mm'],
)

toolchain.register_language(
 	'objcpp_header',
    family: 'c',
    is_header: true,
)

toolchain.register_language(
    'assembly',
    file_extensions: ['s', 'S'],
)

toolchain.register_language(
    'llvm_ir',
    file_extensions: ['ll'],
)

toolchain.register_language(
    'nasm',
    toolchain_options: {
        'compiler': 'NASM',
        'linker': 'NASM_LD',
        'archiver': 'AR',
    },
    file_extensions: ['asm'],
)

toolchain.register_language(
    'masm',
)

toolchain.register_language(
    'rust',
    file_extensions: ['rs'],
)

toolchain.register_language(
    'vala',
    toolchain_options: {
        'compiler': 'VALAC',
        'linker': 'VALAC_LD',
        'archiver': 'AR',
    },
    file_extensions: ['vala', 'vapi'],
)

toolchain.register_language(
    'fortran',
)
