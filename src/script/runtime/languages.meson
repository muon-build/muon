toolchain = import('toolchain')

toolchain.register_language(
    'c_header',
    family: 'c',
    is_header: true,
    file_extensions: ['h'],
)

toolchain.register_language(
    'c',
    family: 'c',
    header_language: 'c_header',
    file_extensions: ['c'],
    toolchain_options: {
        'compiler': 'CC',
        'linker': 'CC_LD',
        'archiver': 'AR',
    },
    options: {
        'std': toolchain.option(type: 'string', value: 'none'),
        'args': toolchain.option(type: 'shell_array', inherit_env: ['CFLAGS', 'CPPFLAGS']),
        'link_args': toolchain.option(type: 'shell_array', inherit_env: ['LDFLAGS', 'CPPFLAGS']),
        'winlibs': toolchain.option(type: 'array', value: []), # TODO
        'thread_count': toolchain.option(type: 'array', value: []), # TODO
    },
    coalesce_link_language: func(new str) -> str
        if new in ['cpp']
            return new
        endif
        return 'c'
    endfunc,
)

toolchain.register_language(
    'object',
    is_linkable: true,
    file_extensions: ['o', 'obj'],
    link_language: 'c',
)

toolchain.register_language(
    'cpp_header',
    family: 'c',
    is_header: true,
    file_extensions: ['hh', 'hpp', 'hxx'],
)

toolchain.register_language(
    'cpp',
    family: 'c',
    header_language: 'cpp_header',
    toolchain_options: {
        'compiler': 'CXX',
        'linker': 'CXX_LD',
        'archiver': 'AR',
    },
    options: {
        'std': toolchain.option(type: 'string', value: 'none'),
        'args': toolchain.option(type: 'shell_array', inherit_env: ['CXXFLAGS', 'CPPFLAGS']),
        'link_args': toolchain.option(type: 'shell_array', inherit_env: ['LDFLAGS', 'CPPFLAGS']),
        'debugstl': toolchain.option(type: 'boolean', value: false), # TODO
        'eh': toolchain.option(
            type: 'combo',
            value: 'default',
            choices: ['none', 'default', 'a', 's', 'sc'],
        ), # TODO
        'rtti': toolchain.option(type: 'boolean', value: true), # TODO
        'thread_count': toolchain.option(type: 'integer', value: 4, min: 0), # TODO
        'winlibs': toolchain.option(type: 'array', value: []), # TODO
    },
    file_extensions: ['cc', 'cpp', 'cxx', 'C'],
    coalesce_link_language: func(_new str) -> str
        return 'cpp'
    endfunc,
)

toolchain.register_language(
    'objc_header',
    family: 'c',
    is_header: true,
)

toolchain.register_language(
    'objc',
    family: 'c',
    header_language: 'objc_header',
    toolchain_options: {
        'compiler': 'OBJC',
        'linker': 'OBJC_LD',
        'archiver': 'AR',
    },
    options: {
        'args': toolchain.option(type: 'shell_array', inherit_env: ['OBJCFLAGS', 'CPPFLAGS']),
        'link_args': toolchain.option(type: 'shell_array', inherit_env: ['LDFLAGS', 'CPPFLAGS']),
    },
    file_extensions: ['m', 'M'],
    link_language: 'c',
)

toolchain.register_language(
    'objcpp_header',
    family: 'c',
    is_header: true,
)

toolchain.register_language(
    'objcpp',
    family: 'c',
    header_language: 'objcpp_header',
    toolchain_options: {
        'compiler': 'OBJCXX',
        'linker': 'OBJCXX_LD',
        'archiver': 'AR',
    },
    options: {
        'args': toolchain.option(type: 'shell_array', inherit_env: ['OBJCXXFLAGS', 'CPPFLAGS']),
        'link_args': toolchain.option(type: 'shell_array', inherit_env: ['LDFLAGS', 'CPPFLAGS']),
    },
    file_extensions: ['mm'],
    link_language: 'cpp',
    coalesce_link_language: func(_new str) -> str
        return 'cpp'
    endfunc,
)

toolchain.register_language(
    'assembly',
    file_extensions: ['s', 'S'],
    link_language: 'c',
    inherit_compile_args: ['c', 'cpp'],
)

toolchain.register_language(
    'llvm_ir',
    file_extensions: ['ll'],
    link_language: 'c',
)

toolchain.register_language(
    'nasm',
    toolchain_options: {
        'compiler': 'NASM',
        'linker': 'NASM_LD',
        'archiver': 'AR',
    },
    file_extensions: ['asm'],
    link_language: 'c',
)

toolchain.register_language(
    'masm',
)

toolchain.register_language(
    'rust',
    options: {
        'std': toolchain.option(type: 'string', value: 'none'),
    },
    file_extensions: ['rs'],
)

toolchain.register_language(
    'vala',
    toolchain_options: {
        'compiler': 'VALAC',
        'linker': 'VALAC_LD',
        'archiver': 'AR',
    },
    file_extensions: ['vala', 'vapi'],
)

toolchain.register_language(
    'fortran',
)
